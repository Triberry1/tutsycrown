{
  "name": "@tutsy-crown/shared",
  "version": "1.0.0",
  "description": "Shared types, validation, API clients, and utilities for Tutsy Crown",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.mjs",
      "require": "./dist/validation/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "tsup backend/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup backend/index.ts --format cjs,esm --dts --watch",
    "api:dev": "nodemon --cwd backend --watch app.ts --watch server.ts --watch config --watch middleware --watch modules --watch utils --watch prisma --ignore node_modules --ignore dist --ignore generated --exec tsx server.ts",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "lint": "eslint backend --ext .ts",
    "type-check": "tsc --noEmit",
    "seed:images": "npm --prefix backend exec tsx prisma/seed-image.ts"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/nextjs": "^7.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.19.0",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.33.0",
    "morgan": "^1.11.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "replicate": "^1.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.5.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}
